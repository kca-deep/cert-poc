# ──────────────────────────────────────────────────────────────────
# cert-poc 백엔드 설정 (src/config.py 가 로드)
#   이 파일을 `.env` 로 복사해 환경에 맞게 수정하세요.
#   .env 는 .gitignore 대상(비밀키 보호), .env.example 만 커밋됩니다.
# ──────────────────────────────────────────────────────────────────

# ── LLM 공급자 선택 ────────────────────────────────────────────────
#   local  : 내부망 OpenAI 호환 서버(llama.cpp / Ollama 등)
#   claude : Anthropic Claude Haiku (외부 API, 인터넷 필요)
# 프론트엔드 토글이 분석마다 이 값을 덮어쓸 수 있으며, 여기 값은 "기본 공급자"다.
LLM_PROVIDER=local

# ── local 공급자 (OpenAI 호환 / llama.cpp / LM Studio / Ollama) ────
# 후보 엔드포인트(콤마구분, 앞에서부터 우선순위). 분석 전 순서대로 health 체크해
# 첫 응답 서버를 채택하고, 그 서버가 보고하는 실제 model id 를 자동 사용한다.
# 여러 모델을 포트별로 띄워두면(예: 11434=ollama, 8080=gpt-oss, 8081=exaone)
# 살아있는 쪽이 잡힌다.
#
# ▸ 자동탐지: LOCAL_BASE_URLS 를 비워두면 공통 후보(11434 Ollama → 8080 llama.cpp
#   → 8081 llama.cpp → 1234 LM Studio)를 자동 스캔한다. 즉 Ollama 만 띄워두면
#   설정 없이도 잡힌다.
# ▸ Ollama: 네이티브 /api/ps(메모리 로딩=실행중) → /api/tags(설치됨) 순으로 실제
#   모델을 자동 인식하므로 LLM_MODEL 을 지정하지 않아도 된다.
LOCAL_BASE_URLS=http://127.0.0.1:11434/v1,http://127.0.0.1:8080/v1,http://127.0.0.1:8081/v1
# 단일 폴백(LOCAL_BASE_URLS 미설정 시) — 그 뒤로 공통 후보가 폴백으로 덧붙는다
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# 프로브가 model id 를 못 읽을 때의 폴백(서버 로드 모델 ID와 일치해야 함).
# holistic 검출 코어는 cert-harness 외과적 v2(gemma4 + llama.cpp native grammar)를
# 프로덕션 모델로 한다. 출력은 response_format=json_schema 로 GBNF 강제된다.
LLM_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_XL
# holistic 운영조건(cert-harness Run E 확정): temp=0(결정성), max_tokens=8000.
# ※ 서버(llama.cpp)는 thinking 폭주 방지를 위해 반드시 아래 옵션으로 기동:
#   llama-server -hf <model> --port 8080 --ctx-size 8192 --n-gpu-layers 999 \
#                --reasoning-budget 6000 --parallel 3 --temp 0
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8000
LLM_REASONING_EFFORT=medium   # gpt-oss 계열 전용(폴백 모델). gemma4 에는 미전송.
# holistic: gemma4 가 어려운 문항에서 thinking 으로 ~200s 까지 걸린다. 짧으면(120)
# 그 문항이 'Request timed out' 으로 떨어지므로 넉넉히 둔다.
LLM_TIMEOUT=600
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=5
# KV 캐시 격리 (서버 슬롯 혼용 방지). llama.cpp 전용이며 Ollama 에는 전송되지 않는다.
LLM_CACHE_PROMPT=false
LLM_SLOT_ROUND_ROBIN=false
LLM_N_SLOTS=3                  # 서버 --parallel 와 일치시킬 것 (현재 3)

# ── claude 공급자 (Anthropic) ─────────────────────────────────────
# ANTHROPIC_API_KEY 는 anthropic SDK 가 환경변수에서 자동으로 읽습니다.
# 이미 셸 환경에 export 돼 있다면 비워 두어도 됩니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
CLAUDE_MAX_RETRIES=1
CLAUDE_RETRY_DELAY=3

# ── HWP 파싱 (폐쇄망에서 자동 탐색 실패 시 명시) ───────────────────
# NODE_BIN=C:/Program Files/nodejs/node.exe
# KORDOC_CLI_PATH=C:/.../node_modules/kordoc/dist/cli.js
