# ──────────────────────────────────────────────────────────────────
# cert-poc 백엔드 설정 (src/config.py 가 로드)
#   이 파일을 `.env` 로 복사해 환경에 맞게 수정하세요.
#   .env 는 .gitignore 대상(비밀키 보호), .env.example 만 커밋됩니다.
# ──────────────────────────────────────────────────────────────────

# ── LLM 공급자 선택 ────────────────────────────────────────────────
#   local  : 내부망 OpenAI 호환 서버(EXAONE/gpt-oss 등)
#   claude : Anthropic Claude Haiku (외부 API, 인터넷 필요)
# 프론트엔드 토글이 분석마다 이 값을 덮어쓸 수 있으며, 여기 값은 "기본 공급자"다.
LLM_PROVIDER=local

# ── local 공급자 (OpenAI 호환 / llama.cpp / LM Studio) ─────────────
# 후보 엔드포인트(콤마구분, 앞에서부터 우선순위). 분석 전 순서대로 health 체크해
# 첫 응답 서버를 채택하고, 그 서버가 보고하는 실제 model id 를 자동 사용한다.
# 여러 모델을 포트별로 띄워두면(예: 8080=gpt-oss, 8081=exaone) 살아있는 쪽이 잡힌다.
LOCAL_BASE_URLS=http://127.0.0.1:8080/v1,http://127.0.0.1:8081/v1
# 단일 폴백(LOCAL_BASE_URLS 미설정 시) — 하위호환
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# 프로브가 model id 를 못 읽을 때의 폴백(서버 로드 모델 ID와 일치해야 함)
LLM_MODEL=lgai-exaone/exaone-3.5-32b-instruct
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=16000
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=5
# KV 캐시 격리 (서버 슬롯 혼용 방지)
LLM_CACHE_PROMPT=false
LLM_SLOT_ROUND_ROBIN=false
LLM_N_SLOTS=4

# ── claude 공급자 (Anthropic) ─────────────────────────────────────
# ANTHROPIC_API_KEY 는 anthropic SDK 가 환경변수에서 자동으로 읽습니다.
# 이미 셸 환경에 export 돼 있다면 비워 두어도 됩니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_TOKENS=2048
CLAUDE_MAX_RETRIES=1
CLAUDE_RETRY_DELAY=3

# ── clovax 공급자 (Naver HyperCLOVA X / CLOVA Studio) ──────────────
# CLOVA Studio 는 OpenAI 호환 엔드포인트를 제공한다. 발급키는 'nv-' 로 시작하는
# Bearer 토큰이며, 모델 ID 는 HCX-005 / HCX-007 / HCX-DASH-002 등을 쓴다.
CLOVASTUDIO_API_KEY=nv-...
CLOVASTUDIO_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
CLOVASTUDIO_MODEL=HCX-005
CLOVASTUDIO_MAX_TOKENS=2048
CLOVASTUDIO_MAX_RETRIES=1
CLOVASTUDIO_RETRY_DELAY=3

# ── HWP 파싱 (폐쇄망에서 자동 탐색 실패 시 명시) ───────────────────
# NODE_BIN=C:/Program Files/nodejs/node.exe
# KORDOC_CLI_PATH=C:/.../node_modules/kordoc/dist/cli.js
